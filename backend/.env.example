# ---------- Core ----------
PORT=4000
DATABASE_URL=postgresql://portal:portal@localhost:5432/infra_portal
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# Where the front end runs (for CORS)
WEB_ORIGIN=http://localhost:5173

# ---------- Provisioning (creating the server) ----------
# mock   = simulate everything (no Terraform needed)
# local  = run the Terraform CLI on this machine (real Proxmox)
# gitlab = commit main.tf to GitLab and run a GitLab CI pipeline
PROVISIONER=mock
# Folder where one sub-folder per request (with main.tf and state) is created
TERRAFORM_WORKDIR=./terraform-runs
# Path to the terraform binary (on Windows e.g. C:\terraform\terraform.exe)
TERRAFORM_BIN=terraform
# AWS requests only generate + validate Terraform unless this is true (avoids cloud cost)
AWS_APPLY_ENABLED=false

# ---------- Proxmox (used when PROVISIONER=local or gitlab) ----------
PROXMOX_ENDPOINT=https://192.168.1.50:8006/
# Format: user@realm!tokenid=secret, e.g. terraform@pve!portal=xxxxxxxx-xxxx
PROXMOX_API_TOKEN=
PROXMOX_NODE=pve
PROXMOX_DATASTORE=local-lvm
PROXMOX_LXC_TEMPLATE=local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst
PROXMOX_BRIDGE=vmbr0
# Root password set on new containers
PROXMOX_CONTAINER_PASSWORD=ChangeMe@123

# ---------- AWS (only if AWS_APPLY_ENABLED=true) ----------
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read by Terraform from the environment

# ---------- GitLab (used when PROVISIONER=gitlab) ----------
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_BRANCH=main

# ---------- Configuration (setting up the server after it is created) ----------
# mock = simulate the AWX job, awx = call a real AWX server
CONFIGURATOR=mock
AWX_URL=https://awx.example.com
AWX_TOKEN=
AWX_JOB_TEMPLATE_ID=

# ---------- Demo ----------
# Delay (milliseconds) for each simulated step, so the status changes are visible
MOCK_STEP_DELAY_MS=4000
