# Generated by Infra Portal for request #{{requestId}}. Do not edit by hand.
# Creates one EC2 instance in AWS.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# AWS keys are read from the environment (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
provider "aws" {
  region = "{{awsRegion}}"
}

# Find the latest official Ubuntu 22.04 image.
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

resource "aws_instance" "server" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = "{{awsInstanceType}}"

  root_block_device {
    volume_size = {{diskGb}}
  }

  tags = {
    Name        = "{{hostname}}"
    Environment = "{{environment}}"
    Team        = "{{teamTag}}"
    RequestId   = "{{requestId}}"
    ManagedBy   = "infra-portal"
  }
}

output "instance_id" {
  value = aws_instance.server.id
}

output "private_ip" {
  value = aws_instance.server.private_ip
}
