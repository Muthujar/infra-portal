# Generated by Infra Portal for request #{{requestId}}. Do not edit by hand.
# Creates one Linux container (LXC) in Proxmox VE.

terraform {
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = ">= 0.66.0"
    }
  }
}

# Secrets are NOT written in this file. The worker passes them as
# environment variables: TF_VAR_proxmox_endpoint, TF_VAR_proxmox_api_token, TF_VAR_container_password
variable "proxmox_endpoint" {
  type = string
}

variable "proxmox_api_token" {
  type      = string
  sensitive = true
}

variable "container_password" {
  type      = string
  sensitive = true
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token
  insecure  = true # Proxmox uses a self-signed certificate by default
}

resource "proxmox_virtual_environment_container" "server" {
  node_name    = "{{proxmoxNode}}"
  description  = "Request #{{requestId}} by {{requesterEmail}} ({{environment}})"
  tags         = ["infra-portal", "{{environmentTag}}", "team-{{teamTag}}"]
  unprivileged = true
  started      = true

  initialization {
    hostname = "{{hostname}}"

    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }

    user_account {
      password = var.container_password
    }
  }

  cpu {
    cores = {{cpu}}
  }

  memory {
    dedicated = {{memoryMb}}
  }

  disk {
    datastore_id = "{{proxmoxDatastore}}"
    size         = {{diskGb}}
  }

  network_interface {
    name   = "eth0"
    bridge = "{{proxmoxBridge}}"
  }

  operating_system {
    template_file_id = "{{proxmoxTemplate}}"
    type             = "ubuntu"
  }
}

output "container_id" {
  value = proxmox_virtual_environment_container.server.vm_id
}
